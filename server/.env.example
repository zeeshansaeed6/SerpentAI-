# Gemini API Key (Required for AI Vision & SerpentBot)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port
PORT=5000

# PostgreSQL connection string (Supabase).
# Leave blank for local development (uses an in-memory Postgres; data is lost on restart).
# REQUIRED in production. In Supabase click "Connect" and copy the *Session pooler* string
# (IPv4-compatible), then replace [YOUR-PASSWORD]. URL-encode special characters in the password.
# Example: postgresql://postgres.abcdefghij:YourPassword@aws-0-us-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Allowed browser origin(s) for CORS, comma-separated. Only needed when the frontend is
# hosted separately from this server.
CLIENT_ORIGIN=http://localhost:5173

# --- Production (set these in your host's environment settings, not here) ---
# NODE_ENV=production
# Number of reverse-proxy hops in front of the server (hosting platforms: 1).
# TRUST_PROXY=1
# Max database connections (default 10). Lower it if your pooler plan has a small limit.
# DB_POOL_MAX=10